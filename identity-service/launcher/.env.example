# Local-development key only; generate with: openssl rand -hex 32
LAUTH_HASHER_KEY=0123456789abcdef0123456789abcdef

LAUTH_SESSION_EXPIRATION=P7D
LAUTH_SESSION_ACCESS_TOKEN_ISSUER=lauth
LAUTH_SESSION_ACCESS_TOKEN_EXPIRATION=PT5M
LAUTH_SESSION_REFRESH_TOKEN_EXPIRATION=P7D

LAUTH_DISPLAYNAME_ADJECTIVE_SOURCE=/opt/lauth/data/adjectives
LAUTH_DISPLAYNAME_NOUN_SOURCE=/opt/lauth/data/nouns

LAUTH_JWKS_ACTIVE_KID=local
LAUTH_JWKS_KEY_SOURCE=/opt/lauth/secrets

LAUTH_SYNC_SCOPE_DEFINITION=true

# Enable only for k6 environments. Mount the IDs file's directory for other containers.
LAUTH_TEST_ENABLED=false
LAUTH_TEST_USER_COUNT=1000
LAUTH_TEST_IDS_FILE=/tmp/lauth-test-user-ids.txt
LAUTH_TEST_CLIENT_SECRET=

PORT=8090
OTLP_ENABLED=false
OTLP_ENDPOINT=otlp-endpoint-here-if-otlp-enabled

DB_URL=jdbc:postgresql://127.0.0.1:5432/lauth
DB_USERNAME=lauth_user
DB_PASSWORD=db-password-here
KAFKA_URL=127.0.0.1:9092
SPRING_MAIL_PASSWORD=spring-mail-password-here

OAUTH2_GITHUB_CLIENT_ID=change-me
OAUTH2_GITHUB_CLIENT_SECRET=change-me
OAUTH2_GOOGLE_CLIENT_ID=change-me
OAUTH2_GOOGLE_CLIENT_SECRET=change-me

FLYWAY_BASELINE_ON_MIGRATE=true
