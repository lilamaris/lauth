# Optional overrides consumed by script/docker-compose.yaml.
LAUTH_POSTGRES_PASSWORD=experience-only-db-password
LAUTH_SESSION_EXPIRATION=P7D
LAUTH_SESSION_ACCESS_TOKEN_ISSUER=lauth
LAUTH_SESSION_ACCESS_TOKEN_EXPIRATION=PT5M
LAUTH_SESSION_REFRESH_TOKEN_EXPIRATION=P7D

# Optional: real credentials are required only to exercise social login.
OAUTH2_GITHUB_CLIENT_ID=local-demo
OAUTH2_GITHUB_CLIENT_SECRET=local-demo
OAUTH2_GOOGLE_CLIENT_ID=local-demo
OAUTH2_GOOGLE_CLIENT_SECRET=local-demo
